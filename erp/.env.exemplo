# Copie para .env e preencha. Nunca versione o .env.
POSTGRES_PASSWORD=troque-esta-senha
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
ERP_SECRET=
ERP_URL_PUBLICA=https://erp.suaempresa.com.br
# Produção na VPS com HTTPS automático (Caddy): domínio, e-mail do certificado e ERP só atrás do proxy
# ERP_DOMINIO=erp.suaempresa.com.br
# ACME_EMAIL=ti@suaempresa.com.br
# ERP_BIND=127.0.0.1
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
# COMPOSE_PROJECT_NAME=erp
# E-mail para "Esqueci a senha" (sem SMTP, o link sai no log do servidor)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
# Fuso de horário (backup e registros)
TZ=America/Sao_Paulo
# Backup diário: hora (00-23) e quantos dias guardar
BACKUP_HORA=03
BACKUP_DIAS=14
# Cópia do backup na nuvem (opcional, via rclone). Exemplo com Backblaze B2 / S3:
# RCLONE_DESTINO=nuvem:nome-do-bucket/erp
# RCLONE_CONFIG_NUVEM_TYPE=s3
# RCLONE_CONFIG_NUVEM_PROVIDER=Other
# RCLONE_CONFIG_NUVEM_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# RCLONE_CONFIG_NUVEM_ACCESS_KEY_ID=
# RCLONE_CONFIG_NUVEM_SECRET_ACCESS_KEY=
RCLONE_DESTINO=
# Monitoramento de erros (opcional): DSN do projeto no Sentry
SENTRY_DSN=
# Versão exibida no painel (ex.: o commit implantado)
APP_VERSAO=
